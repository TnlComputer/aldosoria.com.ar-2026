APP_NAME=SoriaPerfomance
# En el servidor: APP_ENV=production y APP_DEBUG=false (nunca true en produccion)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@aldosoria.com.ar"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS="aldosoria@gmail.com"

# MercadoPago, Checkout Pro via API de Orders (Tus integraciones > Credenciales de produccion)
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
# La Public Key no la usa el sitio (el pago se hace en la pagina de Mercado Pago)
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Tus integraciones > Webhooks: URL https://aldosoria.com.ar/mercadopago/webhook,
# evento "Order (Mercado Pago)". Pegar aca la clave secreta que muestra.
MERCADOPAGO_WEBHOOK_SECRET=

# PayPal (developer.paypal.com > Apps & Credentials). PAYPAL_MODE: live | sandbox
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Cloudflare Turnstile (opcional, gratis): dash.cloudflare.com > Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
